  "steps": [
    {"title": "Decode the VIN and photograph the car", "who": "you", "parts": ["bumper", "headlight_l", "headlight_r"],
     "text": "Get the factory option list from the VIN. It decides which bumper version and which head-unit kit you need.",
     "checks": ["Parking sensors (PDC)?", "Headlight washers?", "Fog lights?", "Xenon or halogen headlights?", "Automatic climate control (confirmed)", "Radio type (Business CD or other)"]},
    {"title": "Bumper off: inspect the structure", "who": "mechanic", "parts": ["carrier", "crash_l", "crash_r", "leg_l", "leg_r", "crumpled"],
     "text": "With the bumper off, check the impact bar and crash absorbers are straight, and identify the crumpled silver section at the front corner. The chassis legs were already checked and are fine.",
     "checks": ["Crumpled silver section identified", "Impact bar straight, not creased", "Crash absorbers not compressed (replace if crushed)", "Mounting bolts not pulled"]},
    {"title": "Check the cooling pack", "who": "mechanic", "parts": ["intercooler", "boost_l", "boost_r", "condenser", "radiator", "fan"],
     "text": "Front hits often damage the intercooler and condenser before the radiator. Check all three plus the boost pipes.",
     "warn": "Only open the cooling system when the engine is cold.",
     "checks": ["Radiator pressure test", "A/C holds gas / condenser not leaking", "Intercooler not cracked, pipes and clips intact", "Fan shroud clips"]},
    {"title": "Fit the slam panel, headlights and latch", "who": "mechanic", "parts": ["slam_top", "slam_l", "slam_r", "latch", "headlight_l", "headlight_r", "snorkel", "airbox"],
     "text": "The replacement slam panel goes in, the headlights refit on good tabs, the torn airbox snorkel is replaced, and the bonnet latch and cable are checked.",
     "checks": ["Missing headlight: removed or broken?", "Headlight tabs intact", "Airbox snorkel replaced", "Bonnet opens and latches cleanly", "Headlight aim"]},
    {"title": "Alignment and the gap baseline", "who": "mechanic", "parts": ["bonnet", "wing_l", "wing_r", "headlight_l", "headlight_r"],
     "text": "Wheel alignment, then photograph and note the bonnet, wing and headlight gaps. That's your baseline before any new bumper.",
     "checks": ["Alignment printout", "Even bonnet-to-wing gaps both sides", "Headlights flush with the bonnet and wings"]},
    {"title": "Test-fit the 1M-style bumper (owned)", "who": "you", "parts": ["bumper", "lower_grille", "kidney_l", "kidney_r", "fixings", "fixings_r"],
     "text": "You have the bumper. List what came with it, confirm its parking-sensor and washer holes match your VIN options, then test-fit with all grilles and fixings and check the gaps against the baseline.",
     "checks": ["PDC / washer holes match your car (or plan to fill/cover them)", "Kidney grilles + right side-vent mesh found or priced", "Brackets and fixings complete", "Even gaps to wings and headlights"]},
    {"title": "Seal or paint the bumper, then wrap (last)", "who": "you", "parts": ["bumper", "bonnet", "wing_l", "wing_r"],
     "text": "The new bumper is bare primer: get it sealed or painted and smooth first, because vinyl lifts on primer. Then clean, clay and degrease all panels, remove badges and trims where possible, and wrap in satin gunmetal grey.",
     "checks": ["Bumper sealed/painted and smooth", "Panels repaired and gapped", "Surfaces clean and wax-free", "Warm, dust-free space"]}
